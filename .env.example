# Environment configuration for Agentic Market Research Assistant

# Application Mode: fixture | live
APP_MODE=fixture

# Market Data Providers (Optional for fixture mode)
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=

# LLM Providers (Optional for fixture mode)
ANTHROPIC_API_KEY=

# OpenTelemetry / Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agentic-market-research-assistant
